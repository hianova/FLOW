/-
  FlowGen.lean
  ================================================================================
  FLOW L0 — Deterministic Lean 4 SSOT Header & Chebyshev Table Generator (Lock 2)
  ================================================================================
  Single-source emits `src/flow_ssot_gen.h` directly from `FlowSpec.lean`
  definitions (`isqrtChebEntry 0..191`, Goldilocks F_p constants, 10-bit Hardware
  Sieve masks, and Boundary Pullback tags), sealing the header with a 64-bit
  FNV-1a `SSOT_SPEC_HASH` over `FlowSpec.lean`.
-/

import FlowSpec

namespace FlowGen

def fnv1a64 (bytes : ByteArray) : UInt64 :=
  bytes.foldl (init := FlowSpec.fnvOffset64) fun h b =>
    (h ^^^ b.toUInt64) * FlowSpec.fnvPrime64

private def hexDigit (n : Nat) : Char :=
  let d := n % 16
  if d < 10 then Char.ofNat ('0'.toNat + d)
  else Char.ofNat ('A'.toNat + (d - 10))

def hexU64 (x : UInt64) : String :=
  Id.run do
    let mut chars : List Char := []
    let mut v := x.toNat
    for _ in [0:16] do
      chars := hexDigit (v % 16) :: chars
      v := v / 16
    return String.ofList chars

def hexU32 (x : UInt32) : String :=
  Id.run do
    let mut chars : List Char := []
    let mut v := x.toNat
    for _ in [0:8] do
      chars := hexDigit (v % 16) :: chars
      v := v / 16
    return String.ofList chars

def hexU16 (x : UInt16) : String :=
  Id.run do
    let mut chars : List Char := []
    let mut v := x.toNat
    for _ in [0:4] do
      chars := hexDigit (v % 16) :: chars
      v := v / 16
    return String.ofList chars

def renderChebTableMacro : String :=
  Id.run do
    let mut lines : Array String := #["#define FLOW_SSOT_ISQRT_LIN_TABLE_INIT { \\"]
    for row in [0:24] do
      let mut items : Array String := #[]
      for col in [0:8] do
        let idx := row * 8 + col
        let v := FlowSpec.isqrtChebEntry idx
        let comma := if idx == 191 then "" else ","
        items := items.push s!"0x{hexU32 v}U{comma}"
      let joined := String.intercalate " " items.toList
      let suffix := if row == 23 then " }" else " \\"
      lines := lines.push s!"    {joined}{suffix}"
    return String.intercalate "\n" lines.toList

def renderHeader (specHash : UInt64) : String :=
  let hHex := hexU64 specHash
  String.intercalate "\n" [
    "/* clang-format off */",
    "/*",
    " * ============================================================================",
    " * AUTO-GENERATED BY FlowGen.lean FROM FlowSpec.lean — DO NOT EDIT MANUALLY",
    s!" * SSOT_SPEC_HASH: 0x{hHex}",
    " * ============================================================================",
    " */",
    "#ifndef FLOW_SSOT_GEN_H",
    "#define FLOW_SSOT_GEN_H",
    "",
    "#include <stdint.h>",
    "",
    s!"#define FLOW_SSOT_SPEC_HASH UINT64_C(0x{hHex})",
    "",
    s!"#define FLOW_SSOT_Q16_SHIFT {FlowSpec.qshift}U",
    s!"#define FLOW_SSOT_Q16_ONE INT64_C({FlowSpec.q16One})",
    s!"#define FLOW_SSOT_WAVE64_SIZE {FlowSpec.wave64Size}U",
    s!"#define FLOW_SSOT_QPOLY_PLANES {FlowSpec.qpolyMaxPlanes}U",
    s!"#define FLOW_SSOT_CUBICAL_MAX_DIM {FlowSpec.cubicalMaxDim}U",
    "",
    s!"#define FLOW_SSOT_HW_PAGE_BYTES {FlowSpec.hwPageBytes}U",
    s!"#define FLOW_SSOT_HW_CACHE_LINE_BYTES {FlowSpec.hwCacheLineBytes}U",
    s!"#define FLOW_SSOT_HW_CACHE_LINE_APPLE_BYTES {FlowSpec.hwCacheLineAppleBytes}U",
    s!"#define FLOW_SSOT_HW_L1D_BYTES {FlowSpec.hwL1dBytes}U",
    s!"#define FLOW_SSOT_HW_VECTOR_BYTES {FlowSpec.hwVectorBytes}U",
    s!"#define FLOW_SSOT_HW_WAVE_LANES {FlowSpec.hwWaveLanes}U",
    s!"#define FLOW_SSOT_HW_FALLBACK_X86_HZ UINT64_C({FlowSpec.hwFallbackX86Hz})",
    s!"#define FLOW_SSOT_HW_FALLBACK_ARM_HZ UINT64_C({FlowSpec.hwFallbackArmHz})",
    "",
    s!"#define FLOW_SSOT_GOLDEN_RATIO_64 UINT64_C(0x{hexU64 FlowSpec.goldenRatio64})",
    s!"#define FLOW_SSOT_FNV_OFFSET_64 UINT64_C(0x{hexU64 FlowSpec.fnvOffset64})",
    s!"#define FLOW_SSOT_FNV_PRIME_64 UINT64_C(0x{hexU64 FlowSpec.fnvPrime64})",
    s!"#define FLOW_SSOT_GOLDILOCKS_PRIME UINT64_C(0x{hexU64 FlowSpec.goldilocksPrime})",
    s!"#define FLOW_SSOT_GOLDILOCKS_EPS UINT64_C(0x{hexU64 FlowSpec.goldilocksEps})",
    s!"#define FLOW_SSOT_FP64_SPONGE_ROUND_CONST UINT64_C(0x{hexU64 FlowSpec.fp64SpongeRoundConst})",
    "",
    s!"#define FLOW_SSOT_BOUNDARY_TAG_MAGIC UINT64_C(0x{hexU64 FlowSpec.boundaryTagMagic})",
    s!"#define FLOW_SSOT_BOUNDARY_TAG_PREFIX_MASK UINT64_C(0x{hexU64 FlowSpec.boundaryTagPrefixMask})",
    s!"#define FLOW_SSOT_BOUNDARY_PAYLOAD_MASK UINT64_C(0x{hexU64 FlowSpec.boundaryPayloadMask})",
    s!"#define FLOW_SSOT_HOTT_BOUNDARY_OVERFLOW UINT16_C(0x{hexU16 FlowSpec.hottBoundaryOverflow})",
    "",
    s!"#define FLOW_SSOT_SIEVE_INT_NO_OVERFLOW UINT64_C(0x{hexU64 FlowSpec.sieveIntNoOverflow})",
    s!"#define FLOW_SSOT_SIEVE_INT_NO_CARRY UINT64_C(0x{hexU64 FlowSpec.sieveIntNoCarry})",
    s!"#define FLOW_SSOT_SIEVE_DOMAIN_VALID UINT64_C(0x{hexU64 FlowSpec.sieveDomainValid})",
    s!"#define FLOW_SSOT_SIEVE_INT_NO_DIVZERO UINT64_C(0x{hexU64 FlowSpec.sieveIntNoDivzero})",
    s!"#define FLOW_SSOT_SIEVE_Q_NO_SATURATION UINT64_C(0x{hexU64 FlowSpec.sieveQNoSaturation})",
    s!"#define FLOW_SSOT_SIEVE_MEM_MASKED_INBOUNDS UINT64_C(0x{hexU64 FlowSpec.sieveMemMaskedInbounds})",
    s!"#define FLOW_SSOT_SIEVE_MEM_ALIGNED UINT64_C(0x{hexU64 FlowSpec.sieveMemAligned})",
    s!"#define FLOW_SSOT_SIEVE_QPOLY_INTERIOR UINT64_C(0x{hexU64 FlowSpec.sieveQpolyInterior})",
    s!"#define FLOW_SSOT_SIEVE_JET2_TAYLOR_0 UINT64_C(0x{hexU64 FlowSpec.sieveJet2Taylor0})",
    s!"#define FLOW_SSOT_SIEVE_JET2_TAYLOR_1 UINT64_C(0x{hexU64 FlowSpec.sieveJet2Taylor1})",
    s!"#define FLOW_SSOT_SIEVE_ALL_SOUND UINT64_C(0x{hexU64 FlowSpec.sieveAllSound})",
    "",
    renderChebTableMacro,
    "",
    "#endif /* FLOW_SSOT_GEN_H */",
    "/* clang-format on */",
    ""
  ]

end FlowGen

def main (args : List String) : IO UInt32 := do
  let specBytes ← IO.FS.readBinFile "FlowSpec.lean"
  let specHash := FlowGen.fnv1a64 specBytes
  let expected := FlowGen.renderHeader specHash
  match args with
  | ["--check", outPath] =>
    let actual ← IO.FS.readFile outPath
    if actual == expected then
      IO.println s!"  [PASS] {outPath} matches FlowSpec.lean (SSOT_SPEC_HASH=0x{FlowGen.hexU64 specHash})"
      return 0
    else
      IO.eprintln s!"ERROR: {outPath} drifted from FlowSpec.lean! Run FlowGen to regenerate."
      return 1
  | [outPath] =>
    IO.FS.writeFile outPath expected
    IO.println s!"  [GEN]  {outPath} (SSOT_SPEC_HASH=0x{FlowGen.hexU64 specHash})"
    return 0
  | _ =>
    IO.eprintln "Usage: flow-gen [--check] <output_header_path>"
    return 2
