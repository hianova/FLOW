input sensor_frames {
    max_count 10000
}

flow spinal_reflex {
    sensor_frames -> transform -> collect
}

jet embodied_dynamics {
    target_frequency 10000hz
    symplectic
    max_drift 0.005%
    zmp_margin 0.02
    dim 4
}

thermal dissipation {
    max_temp 95.0c
    target_temp 85.0c
    power_limit 25.0w
    r_thermal 6.0
    c_thermal 0.05
}

require {
    deterministic
    memory < 32mb
}

prefer {
    latency
}
